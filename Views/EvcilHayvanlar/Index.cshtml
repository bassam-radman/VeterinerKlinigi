@model IEnumerable<VeterinerKlinigi.Models.EvcilHayvan>

@{
    ViewData["Title"] = "Evcil Hayvan Yönetimi";

    var sahipler = ViewBag.SahipEpostalar
        as Dictionary<string, string?>
        ?? new Dictionary<string, string?>();
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Evcil Hayvan Yönetimi</h1>

        <a asp-action="Create" class="btn btn-primary">
            + Yeni Hayvan Ekle
        </a>
    </div>

    @if (TempData["BasariMesaji"] != null)
    {
        <div class="alert alert-success">
            @TempData["BasariMesaji"]
        </div>
    }

    @if (TempData["HataMesaji"] != null)
    {
        <div class="alert alert-danger">
            @TempData["HataMesaji"]
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body table-responsive">

            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Ad</th>
                        <th>Tür</th>
                        <th>Irk</th>
                        <th>Doğum Tarihi</th>
                        <th>Kilo</th>
                        <th>Sahip</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var hayvan in Model)
                    {
                        <tr>
                            <td class="fw-bold">@hayvan.Ad</td>
                            <td>@hayvan.Tur</td>
                            <td>@hayvan.Irk</td>
                            <td>@hayvan.DogumTarihi.ToString("dd.MM.yyyy")</td>
                            <td>@hayvan.Kilo.ToString("N2") kg</td>
                            <td>
                                @(sahipler.ContainsKey(hayvan.SahipId)
                                    ? sahipler[hayvan.SahipId]
                                    : "Bilinmiyor")
                            </td>
                            <td>
                                @(hayvan.AktifMi ? "Aktif" : "Pasif")
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@hayvan.Id"
                                       class="btn btn-warning btn-sm">
                                        Düzenle
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@hayvan.Id"
                                          method="post"
                                          asp-antiforgery="true"
                                          onsubmit="return confirm('Hayvan kaydı silinsin mi?');">

                                        <button class="btn btn-danger btn-sm"
                                                type="submit">
                                            Sil
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    Henüz kayıtlı evcil hayvan bulunmuyor.
                </div>
            }

        </div>
    </div>
</div>
