@model VeterinerKlinigi.Models.Hizmet

@{
    ViewData["Title"] = "Yeni Hizmet Ekle";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-primary text-white p-4">
                    <h3 class="mb-0">Yeni Hizmet Ekle</h3>
                    <p class="mb-0 mt-2">
                        Kliniğe yeni bir hizmet tanımlayın.
                    </p>
                </div>

                <div class="card-body p-4">

                    <form asp-controller="Hizmetler"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Ad"
                                   class="form-label">
                                Hizmet Adı
                            </label>

                            <input asp-for="Ad"
                                   class="form-control"
                                   placeholder="Örn: Genel Muayene" />

                            <span asp-validation-for="Ad"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Aciklama"
                                   class="form-label">
                                Açıklama
                            </label>

                            <textarea asp-for="Aciklama"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Hizmet açıklaması"></textarea>

                            <span asp-validation-for="Aciklama"
                                  class="text-danger"></span>
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="SureDakika"
                                       class="form-label">
                                    Süre (Dakika)
                                </label>

                                <input asp-for="SureDakika"
                                       type="number"
                                       min="1"
                                       max="480"
                                       class="form-control" />

                                <span asp-validation-for="SureDakika"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Ucret"
                                       class="form-label">
                                    Ücret (TL)
                                </label>

                                <input asp-for="Ucret"
                                       type="number"
                                       min="0.01"
                                       step="0.01"
                                       class="form-control" />

                                <span asp-validation-for="Ucret"
                                      class="text-danger"></span>
                            </div>

                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="AktifMi"
                                   class="form-check-input" />

                            <label asp-for="AktifMi"
                                   class="form-check-label">
                                Hizmet Aktif
                            </label>
                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Hizmeti Kaydet
                            </button>

                            <a asp-controller="Hizmetler"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                İptal
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
