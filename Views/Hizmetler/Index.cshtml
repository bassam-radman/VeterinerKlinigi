@model IEnumerable<VeterinerKlinigi.Models.Hizmet>

@{
    ViewData["Title"] = "Hizmet Yönetimi";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Hizmet Yönetimi</h1>
            <p class="text-muted">
                Kliniğimizin sunduğu hizmetler
            </p>
        </div>
        
        <a asp-controller="Hizmetler"
           asp-action="Create"
           class="btn btn-primary me-2">
            + Yeni Hizmet Ekle
        </a>


        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Yönetim Paneline Dön
        </a>
    </div>
    
    @if (TempData["BasariMesaji"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["BasariMesaji"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat">
            </button>
        </div>
    }

    @if (TempData["HataMesaji"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["HataMesaji"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat">
            </button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Hizmet Adı</th>
                            <th>Açıklama</th>
                            <th>Süre</th>
                            <th>Ücret</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var hizmet in Model)
                        {
                            <tr>
                                <td>@hizmet.Id</td>

                                <td class="fw-bold">
                                    @hizmet.Ad
                                </td>

                                <td>@hizmet.Aciklama</td>

                                <td>
                                    @hizmet.SureDakika dakika
                                </td>

                                <td>
                                    @hizmet.Ucret.ToString("N2") TL
                                </td>

                                <td>
                                    @if (hizmet.AktifMi)
                                    {
                                        <span class="badge bg-success">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Pasif
                                        </span>
                                    }
                                </td>
                                
                                
                                <td>
                                    <div class="d-flex gap-2">

                                        <a asp-controller="Hizmetler"
                                           asp-action="Edit"
                                           asp-route-id="@hizmet.Id"
                                           class="btn btn-warning btn-sm">
                                            Düzenle
                                        </a>

                                        <a asp-controller="Hizmetler"
                                           asp-action="Delete"
                                           asp-route-id="@hizmet.Id"
                                           class="btn btn-danger btn-sm">
                                            Sil
                                        </a>

                                    </div>
                                </td>


                            </tr>
                        }

                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center mt-3">
                    Henüz kayıtlı hizmet bulunmuyor.
                </div>
            }

        </div>
    </div>

</div>
