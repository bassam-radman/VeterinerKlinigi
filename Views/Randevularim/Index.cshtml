@model IEnumerable<VeterinerKlinigi.Models.Randevu>
@using VeterinerKlinigi.Models

@{
    ViewData["Title"] = "Randevularım";
}

<div class="container py-5">

    <h1 class="fw-bold mb-2">Randevularım</h1>

    <p class="text-muted mb-4">
        Evcil hayvanlarınıza ait randevular
    </p>

    @if (TempData["BasariMesaji"] != null)
    {
        <div class="alert alert-success">
            @TempData["BasariMesaji"]
        </div>
    }

    @if (TempData["HataMesaji"] != null)
    {
        <div class="alert alert-danger">
            @TempData["HataMesaji"]
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Hayvan</th>
                        <th>Veteriner</th>
                        <th>Hizmet</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.EvcilHayvan.Ad</td>
                            <td>@r.Veteriner.AdSoyad</td>
                            <td>@r.Hizmet.Ad</td>

                            <td>
                                @r.RandevuTarihi.ToString("dd.MM.yyyy HH:mm")
                            </td>

                            <td>@r.Durum</td>

                            <td>
                                @if (r.RandevuTarihi > DateTime.Now &&
                                     (r.Durum == RandevuDurumu.Bekliyor ||
                                      r.Durum == RandevuDurumu.Onaylandi))
                                {
                                    <form asp-action="IptalEt"
                                          asp-route-id="@r.Id"
                                          method="post"
                                          asp-antiforgery="true"
                                          onsubmit="return confirm('Randevuyu iptal etmek istiyor musunuz?');">

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm">
                                            İptal Et
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    Henüz randevunuz bulunmuyor.
                </div>
            }

        </div>
    </div>
</div>
