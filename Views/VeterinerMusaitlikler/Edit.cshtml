@model VeterinerKlinigi.Models.VeterinerMusaitlik

@{
    ViewData["Title"] = "Çalışma Saati Düzenle";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-warning p-4">
                    <h3 class="mb-0">
                        Çalışma Saati Düzenle
                    </h3>
                    <p class="mb-0 mt-2">
                        Veterinerin çalışma programını güncelleyin.
                    </p>
                </div>

                <div class="card-body p-4">

                    <form asp-controller="VeterinerMusaitlikler"
                          asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post"
                          asp-antiforgery="true">

                        <input asp-for="Id" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="VeterinerId"
                                   class="form-label">
                                Veteriner Seçiniz
                            </label>

                            <select asp-for="VeterinerId"
                                    asp-items="ViewBag.Veterinerler"
                                    class="form-select">
                                <option value="">
                                    -- Veteriner Seçiniz --
                                </option>
                            </select>

                            <span asp-validation-for="VeterinerId"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Gun"
                                   class="form-label">
                                Çalışma Günü
                            </label>

                            <select asp-for="Gun"
                                    class="form-select">
                                <option value="1">Pazartesi</option>
                                <option value="2">Salı</option>
                                <option value="3">Çarşamba</option>
                                <option value="4">Perşembe</option>
                                <option value="5">Cuma</option>
                                <option value="6">Cumartesi</option>
                                <option value="0">Pazar</option>
                            </select>

                            <span asp-validation-for="Gun"
                                  class="text-danger"></span>
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="BaslangicSaati"
                                       class="form-label">
                                    Başlangıç Saati
                                </label>

                                <input asp-for="BaslangicSaati"
                                       type="time"
                                       step="60"
                                       class="form-control" />

                                <span asp-validation-for="BaslangicSaati"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="BitisSaati"
                                       class="form-label">
                                    Bitiş Saati
                                </label>

                                <input asp-for="BitisSaati"
                                       type="time"
                                       step="60"
                                       class="form-control" />

                                <span asp-validation-for="BitisSaati"
                                      class="text-danger"></span>
                            </div>

                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="AktifMi"
                                   class="form-check-input" />

                            <label asp-for="AktifMi"
                                   class="form-check-label">
                                Çalışma Saati Aktif
                            </label>
                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-warning">
                                Değişiklikleri Kaydet
                            </button>

                            <a asp-controller="VeterinerMusaitlikler"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                İptal
                            </a>

                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
