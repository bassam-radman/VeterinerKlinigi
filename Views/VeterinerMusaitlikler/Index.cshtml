@model IEnumerable<VeterinerKlinigi.Models.VeterinerMusaitlik>

@{
    ViewData["Title"] = "Veteriner Çalışma Saatleri";

    string[] gunler =
    {
        "Pazar",
        "Pazartesi",
        "Salı",
        "Çarşamba",
        "Perşembe",
        "Cuma",
        "Cumartesi"
    };
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">Veteriner Çalışma Saatleri</h1>

            <p class="text-muted">
                Veterinerlerin haftalık çalışma programı
            </p>
        </div>

        
        <div class="d-flex gap-2">

            <a asp-controller="VeterinerMusaitlikler"
               asp-action="Create"
               class="btn btn-primary">
                + Yeni Çalışma Saati Ekle
            </a>

            <a asp-controller="Admin"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Yönetim Paneline Dön
            </a>

        </div>


    </div>
    
    @if (TempData["BasariMesaji"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["BasariMesaji"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat">
            </button>
        </div>
    }

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Veteriner</th>
                            <th>Gün</th>
                            <th>Başlangıç</th>
                            <th>Bitiş</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var kayit in Model)
                        {
                            <tr>
                                <td>@kayit.Id</td>

                                <td class="fw-bold">
                                    @kayit.Veteriner.AdSoyad
                                </td>

                                <td>
                                    @gunler[(int)kayit.Gun]
                                </td>

                                <td>
                                    @kayit.BaslangicSaati.ToString(@"hh\:mm")
                                </td>

                                <td>
                                    @kayit.BitisSaati.ToString(@"hh\:mm")
                                </td>

                                <td>
                                    @if (kayit.AktifMi)
                                    {
                                        <span class="badge bg-success">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Pasif
                                        </span>
                                    }
                                </td>
                                
                                
                                <td>
                                    <div class="d-flex gap-2">

                                        <a asp-controller="VeterinerMusaitlikler"
                                           asp-action="Edit"
                                           asp-route-id="@kayit.Id"
                                           class="btn btn-warning btn-sm">
                                            Düzenle
                                        </a>

                                        <a asp-controller="VeterinerMusaitlikler"
                                           asp-action="Delete"
                                           asp-route-id="@kayit.Id"
                                           class="btn btn-danger btn-sm">
                                            Sil
                                        </a>

                                    </div>
                                </td>


                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center mt-3">
                    Henüz kayıtlı çalışma saati bulunmuyor.
                </div>
            }

        </div>

    </div>

</div>
