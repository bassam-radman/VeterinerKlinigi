
@model VeterinerKlinigi.Models.Veteriner

@{
    ViewData["Title"] = "Yeni Veteriner Ekle";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-primary text-white p-4">
                    <h3 class="mb-0">Yeni Veteriner Ekle</h3>
                    <p class="mb-0 mt-2">
                        Kliniğe yeni veteriner hekim tanımlayın.
                    </p>
                </div>

                <div class="card-body p-4">

                    <form asp-controller="Veterinerler"
                          asp-action="Create"
                          method="post"
                          asp-antiforgery="true">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="AdSoyad"
                                   class="form-label">
                                Ad Soyad
                            </label>

                            <input asp-for="AdSoyad"
                                   class="form-control"
                                   placeholder="Örn: Ahmet Yılmaz" />

                            <span asp-validation-for="AdSoyad"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UzmanlikAlani"
                                   class="form-label">
                                Uzmanlık Alanı
                            </label>

                            <input asp-for="UzmanlikAlani"
                                   class="form-control"
                                   placeholder="Örn: Küçük Hayvan Hekimliği" />

                            <span asp-validation-for="UzmanlikAlani"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Aciklama"
                                   class="form-label">
                                Açıklama
                            </label>

                            <textarea asp-for="Aciklama"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Veteriner hakkında kısa bilgi"></textarea>

                            <span asp-validation-for="Aciklama"
                                  class="text-danger"></span>
                        </div>

                        <div class="form-check mb-4">

                            <input asp-for="AktifMi"
                                   class="form-check-input" />

                            <label asp-for="AktifMi"
                                   class="form-check-label">
                                Veteriner Aktif
                            </label>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Veterineri Kaydet
                            </button>

                            <a asp-controller="Veterinerler"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                İptal
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

